# ==== UI configuration ====
UI_API_BASE_URL=http://localhost:8000
UI_REQUEST_TIMEOUT=120

# ==== API configuration ====
API_TITLE="Focused Research Agent API"
API_VERSION=2.0.0
API_DEBUG=false
FORCE_HTTPS=false
SHUTDOWN_GRACE_SECONDS=30

# ==== LLM configuration ====
# Ollama cloud alternative
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:20b-cloud
LLM_API_KEY=your_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096

# Groq alternative (comment above 3 lines, uncomment below)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_groq_key_here

# Ollama Local alternative (no API key)
#LLM_PROVIDER=ollama
#LLM_MODEL=llama3.2:3b
#LLM_API_KEY=not-needed

# ==== Search configuration ====
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_key_here
SEARCH_DEPTH=basic
SEARCH_MAX_RESULTS=5

# ==== Database configuration ====
# SQLite (local/dev, default):
DATABASE_URL=sqlite+aiosqlite:///./research_agent.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_agent

# ==== Auth ====
# Generate a real random value for production: openssl rand -hex 32
AUTH_SECRET_KEY=dev-only-insecure-key-change-me
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==== Redis (cache + rate limiting + Celery broker/backend) ====
# Leave REDIS_URL unset for local dev — cache and rate limiter fall back
# to in-process storage automatically. Celery requires it though.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_RESEARCH=20/minute
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_REPORT=5/minute
RATE_LIMIT_AUTH=10/minute

# ==== Logging ====
LOG_LEVEL=INFO
LOG_FORMAT=console

# ==== Observability ====
# Leave unset to skip exporting traces anywhere (traces are still created).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==== Secrets provider ====
# env (default) | aws | azure — see core/secrets.py
SECRETS_PROVIDER=env
